<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="shiyu"
        Arguments=""
        InstallLocation="C:\Program Files\Shiyu\拾语">
    </Installer>
    <PackageInformation
        PackageName="拾语"
        PackageDisplayName="拾语"
        PublisherName="CN=Shiyu"
        PublisherDisplayName="Shiyu"
        Version="0.1.0.0"
        PackageDescription="拾语 · 桌面语音输入">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.shiyu.app"
                Description="拾语 · 桌面语音输入"
                DisplayName="拾语"
                ExecutableName="shiyu"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>拾语</DisplayName>
            <PublisherDisplayName>Shiyu</PublisherDisplayName>
            <Description>拾语 · 桌面语音输入</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="shiyu.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
